        <ui:VisualElement name="Design" style="flex-grow: 1;">
            <ui:Image name="Image" source="project://database/Assets/NKY/Asset/FB001.png?fileID=2800000&amp;guid=17b3159769a5b8c4fa6bf5db03cbc05d&amp;type=3#FB001" tint-color="rgba(0, 0, 0, 0.27)" style="height: 200px; width: 200px; position: absolute; top: 852px; left: 1583px; scale: -1 1; color: rgba(235, 248, 0, 0); rotate: -41deg;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
