                            <ui:Image source="project://database/Assets/0.Asset/download/male/kuro/egg/crack.png?fileID=8795366620419746748&amp;guid=5b70797c210d7fb4b87ea6772b351feb&amp;type=3#crack_0" tint-color="rgba(10, 10, 10, 0.43)" style="height: 45%; width: 20%; margin-right: -17px; margin-top: -8px;"/>
