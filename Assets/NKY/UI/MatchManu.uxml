                        <ui:Button name="matchmakingButton" text="매치메이킹" class="menu-button matchmaking-button" style="-unity-text-align: lower-left; flex-direction: row; align-items: flex-start; justify-content: flex-end; font-size: 25px; width: 100%;">
                            <ui:Image name="Icon" source="project://database/Assets/NKY/Asset/DinoFootIcon.png?fileID=-3338258424178146402&amp;guid=8fbc4f89ef208c44387d37b14e1f6013&amp;type=3#DinoFootIcon_1" tint-color="rgba(0, 0, 0, 0.27)" style="height: 40%; width: 20%;"/>
