    <ui:VisualElement name="root" class="menu-root" style="color: rgb(235, 248, 88); background-color: rgb(44, 48, 82); background-image: none;">
        <ui:Label text="게임 제목" style="position: absolute; height: 121px; width: 597px; top: 74px; left: 652px; -unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf?fileID=12800000&amp;guid=e3265ab4bf004d28a9537516768c1c75&amp;type=3#LiberationSans&quot;); -unity-font-style: bold; font-size: 60px; -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(190, 190, 190); color: rgb(106, 14, 98); text-shadow: 3px 5px 2px rgb(0, 0, 0); right: auto; bottom: auto;"/>
        <ui:VisualElement name="content" class="menu-content" style="height: 844px; top: 248px; width: 1321px; left: 264px;">
            <ui:VisualElement name="Button_container" class="menu-body" style="height: 70%;">
