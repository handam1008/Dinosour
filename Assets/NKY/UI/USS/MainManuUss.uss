/* =========================================================
   MAIN MENU
   1920 x 1080 / 16:9
   ========================================================= */


/* =========================================================
   전체 화면
   ========================================================= */

.main-menu {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    flex-grow: 1;
}


/* =========================================================
   배경
   ========================================================= */

.background {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    background-color: rgb(175, 255, 41);
}


/* =========================================================
   메뉴 컨테이너
   ========================================================= */

.menu-container {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;
}


/* =========================================================
   제목
   ========================================================= */

.game-title {
    position: absolute;

    left: 5.2%;
    top: 12.5%;

    margin: 0;

    color: rgb(5, 192, 102);

    font-size: 96px;

    -unity-font-style: bold;

    -unity-text-align: middle-left;
}


/* =========================================================
   메뉴 리스트
   ========================================================= */

.menu-list {
    position: absolute;

    left: 0;
    right: 0;

    top: 40%;

    width: 100%;

    align-items: flex-start;
}


/* =========================================================
   메뉴 한 줄
   ========================================================= */

.menu-item {
    position: relative;

    width: 100%;
    height: 90px;

    margin-bottom: 20px;

    padding: 0;
}


/* =========================================================
   Hover / Selected 배경
   화면 왼쪽 50%
   ========================================================= */

.hover-background {
    position: absolute;

    left: 0;
    top: 0;

    width: 50%;
    height: 100%;

    background-color: rgba(0, 0, 0, 0);
    
}


/* =========================================================
   버튼
   ========================================================= */

.menu-button {
    position: absolute;

    left: 0;
    right: 0;
    top: 0;
    bottom: 0;

    width: 100%;
    height: 100%;

    margin: 0;

    padding-left: 5.2%;
    padding-right: 0;

    background-color: rgba(0, 0, 0, 0);

    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;

    color: rgb(0, 0, 0);

    font-size: 64px;

    -unity-font-style: bold;

    -unity-text-align: middle-left;
}


/* =========================================================
   마우스 Hover
   ========================================================= */

.menu-item:hover .hover-background {
    background-color: rgb(0, 150, 75);
}


/* =========================================================
   선택된 버튼
   ========================================================= */

.menu-item.selected .hover-background {
    background-color: rgb(0, 150, 75);
}


/* =========================================================
   클릭
   ========================================================= */

.menu-button:active {
    background-color: rgba(0, 0, 0, 0);

    color: rgb(0, 0, 0);
}


/* =========================================================
   Focus
   ========================================================= */

.menu-button:focus {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}


/* =========================================================
   마지막 메뉴
   ========================================================= */

#ExitItem {
    margin-bottom: 0;
}